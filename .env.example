# このファイルを .env にコピーして、環境固有の実値を入れる。
# .env はgit管理外(.gitignore参照)。実機のホスト名・鍵ファイル名など、
# 公開リポジトリに残したくない情報はここに書く。
#
#   cp .env.example .env
#   $EDITOR .env

# 実機のmDNSホスト名(例: kaga0.local / m329.local)。ホスト名の付け方の考え方は
# docs/decisions/0006-hostname-naming.md 参照。
KAGA_HOST=kaga0.local

# 実機に作成するログインユーザー名(Raspberry Pi OS Bookworm以降、既定の`pi`ユーザーは
# 存在しないため、custom.tomlで明示的に作成する必要がある)
KAGA_USER=changeme

# ログインに使うSSH公開鍵ファイル(flash-sdcard.shがcustom.tomlのauthorized_keysに使う)
SSH_PUBKEY_FILE=~/.ssh/id_ed25519.pub

# pmtiles配布元。実体ファイルを直接HTTP GETできるサーバーを指す。
# 詳細は docs/decisions/0005-depot-optgeo-org.md 参照。
PMTILES_BASE_URL=https://depot.optgeo.org
