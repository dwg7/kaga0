# kaga: PMTiles/style.jsonをローカル配信するHTTPサーバー。
#
# **2026-08-30時点で不使用**: pmtiles://file://(mbgl-core内蔵の
# LocalFileSource、HTTPを経由しないバイト範囲read)に切り替えたため、
# kaga-map.serviceはこのユニットに依存しなくなった。fpsは同等、プロセスが
# 1つ減るぶんシンプル。詳細はdocs/decisions/0014・docs/plan.md参照。
# 万一file://方式で問題が出た場合の切り戻し用に残置。
#
# (以下は元の説明)maplibre-nativeのPMTilesFileSourceはHTTP(S) Range要求を
# 使うため、Range非対応のPython http.serverでは動かない。busyboxのhttpdは
# Range対応(206 Partial Content)なのでこれを使っていた。
#
# 127.0.0.1のみで待ち受け(-h でドキュメントルート指定、外部公開はしない)。

[Unit]
Description=kaga - local PMTiles/style HTTP server (busybox httpd)
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/busybox httpd -f -p 127.0.0.1:8080 -h /opt/kaga/data
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
