// Raspberry Pi / small-touch-panel layout for the zero-copy GL example.
// Larger touch targets (bigger fonts + a tall toolbar) and a wide right-edge
// vertical zoom strip so taps land reliably on a low-res resistive panel.
import { Button, ComboBox, HorizontalBox, VerticalBox, Slider, CheckBox } from "std-widgets.slint";
import { MMapView, MMapAdapter } from "../src/maplibre.slint";

export { MMapAdapter }

export struct Size {
    width: length,
    height: length,
}

// A JMA continuously-monitored Hokkaido volcano, for the fly-to ComboBox.
// Coordinates are summit positions (Wikipedia infobox, 2026-08-30); see
// docs/plan.md for the VBM/VLCM-coverage cross-check (8 of 9 fall inside the
// data's bbox -- Esan is just south of the edge, so flying there shows the
// bvmap background but no VBM/VLCM overlay, which is expected, not a bug).
export struct VolcanoEntry {
    name: string,
    lat: float,
    lon: float,
}

export component MapWindow inherits Window {
    preferred-width: 720px;
    preferred-height: 576px;
    default-font-size: 20px;

    out property<Size> map-size: { width: map.width, height: map.height };
    callback map-size-changed;
    // Shutdown button (kaga addition); main_gl.cpp runs `sudo systemctl
    // poweroff` on this (the service's user has passwordless sudo already,
    // needed for other things -- verified 2026-08-30).
    callback request-shutdown();
    changed map-size => { map-size-changed(); }

    // The ComboBox shows the readable names; selecting one applies the URL at
    // the same index (the two lists are kept parallel). C++ replaces both from
    // a `label,url` file when one exists -- pointing the device at a different
    // server, which is the whole of running it off-grid, should not be a
    // rebuild. The lists below are the fallback when no file is found.
    in-out property <[string]> style-names: [
        "kitavolca",
        "bvmap",
    ];
    in-out property <[string]> style-urls: [
        "file:///opt/kaga/data/style.json",
        "file:///opt/kaga/data/style-bvmap-only.json",
    ];

    // JMA's 9 continuously-monitored Hokkaido volcanoes, in JMA's own display
    // order (north-to-south-ish by their grouping, not strict latitude).
    // https://www.data.jma.go.jp/sapporo/bosai/bosaikyoiku/vol/v02_vol_pic.html#obs
    in-out property <[VolcanoEntry]> volcanoes: [
        { name: "アトサヌプリ", lat: 43.6103, lon: 144.4386 },
        { name: "雌阿寒岳", lat: 43.3863, lon: 144.0088 },
        { name: "大雪山(旭岳)", lat: 43.6636, lon: 142.8541 },
        { name: "十勝岳", lat: 43.4178, lon: 142.6863 },
        { name: "樽前山", lat: 42.6906, lon: 141.3767 },
        { name: "倶多楽", lat: 42.5000, lon: 141.1833 },
        { name: "有珠山", lat: 42.5439, lon: 140.8392 },
        { name: "北海道駒ケ岳", lat: 42.0634, lon: 140.6772 },
        { name: "恵山", lat: 41.8047, lon: 141.1661 },
    ];
    // ComboBox.model wants a plain [string]; kept parallel to `volcanoes`
    // above (same order/index) rather than deriving it, since Slint has no
    // array-map expression -- same duplication style-names/style-urls
    // already uses in this file.
    in-out property <[string]> volcano-names: [
        "アトサヌプリ", "雌阿寒岳", "大雪山(旭岳)", "十勝岳", "樽前山",
        "倶多楽", "有珠山", "北海道駒ケ岳", "恵山",
    ];
    // Which volcano the ComboBox shows as selected. `<=>`-aliased to the
    // ComboBox's own `current-index` below so it stays a true two-way
    // binding: manual selection keeps working exactly as before, and
    // patrol mode (main_gl.cpp) can also drive it so the dropdown shows
    // whichever volcano it just flew to (dwg7/kaga0#1).
    in-out property <int> volcano-current-index: 4;

    // "巡回" (patrol) mode toggle (dwg7/kaga0#1): while on, main_gl.cpp
    // auto-cycles the volcanoes on a timer for unattended demo/benchmark
    // use, the same fly-to the ComboBox's own `selected` handler calls.
    in-out property <bool> patrol-on: false;

    // "Dance" toggle: drives the pitch/bearing animation in the C++ backend.
    in-out property <bool> dancing: false;
    callback set-dance(bool);

    // "Sync" toggle: drive map pitch/bearing from the orientation sensors.
    // sensor-available is set by C++ from the live sensor feed; the checkbox
    // is disabled (greyed) when no fresh sensor data is present.
    in property <bool> sensor-available: false;
    callback sync-toggled(bool);

    // Battery (PiSugar): percent + charging state for a small corner readout.
    in property <int> battery-percent: -1;     // -1 = unknown / hidden
    in property <bool> battery-plugged: false;
    in property <image> battery-icon;          // set from C++ (charge/full/high/middle/low)

    // GPS status (from /dev/shm/pi-gps via C++): state 0=no device (grey),
    // 1=no fix (yellow), 2=fix (green); gps-sats = satellites in view.
    in property <int> gps-state: 0;
    in property <int> gps-sats: 0;
    in property <image> gps-icon;   // set from C++ (grey+X/yellow/green satellite)

    // Network/Wi-Fi status (from C++): state 0 = disconnected/down (grey with a
    // red X), 1 = link up but no default route (yellow), 2 = connected with a
    // default route (green). Lets a Wi-Fi drop be seen at a glance.
    in property <int> net-state: 0;
    in property <image> wifi-icon;  // set from C++ (grey+X/yellow/green Wi-Fi glyph)
    in property <string> wifi-ssid: "";   // current SSID (C++; truncated to 15 chars)

    // Dev-only readout: "<width>x<height> <fps>fps". Gated by MAPLIBRE_DEBUG_INFO
    // (main_gl.cpp) so it's off by default for the shipped appliance; kaga is
    // currently in active tuning, so it's on for now (see docs/plan.md).
    in property <string> debug-text: "";
    in property <bool> debug-visible: false;

    // Scale bar: "<value> m"/"<value> km" label plus a bar this many pixels
    // wide, recomputed as the camera moves (main_gl.cpp's saver_timer, from
    // SlintMapGL::get_center_zoom -- the actual rendering zoom/latitude, so
    // it stays correct across pan/zoom/fly-to and MAPLIBRE_ZOOM_BIAS).
    // People who care about ground distance on a printed/presented map
    // asked for this (藤村さん, 2026-08-30); empty text hides the whole
    // element (camera not yet initialised).
    in property <string> scale-bar-text: "";
    in property <length> scale-bar-width-px: 0px;

    // VBM/VLCM feature-attribute readout under the cursor (hover, no press).
    // Empty string hides the panel; see main_gl.cpp's saver_timer for how
    // this gets populated (throttled queryRenderedFeatures via
    // SlintMapGL::query_feature_info).
    in property <string> feature-info-text: "";
    // The classification polygon's own fill color (from style.json's
    // fill-color match-on-"name" expression), shown as a small swatch next
    // to feature-info-text so the bar's label reads back onto the map's own
    // color (藤村さん, 2026-08-30). Transparent when unknown (e.g. the
    // feature's layer uses a constant fill-color) -- the swatch then simply
    // is not visible, which is fine since the text alone still says what it is.
    in property <color> feature-info-color: transparent;

    // Keyboard: green glyph shown while a USB or Bluetooth keyboard is connected.
    in property <bool> kbd-connected: false;
    in property <image> kbd-icon;   // set from C++ (green keyboard PNG)

    // Microphone. Hidden when no ALSA capture device exists -- there is no
    // "no mic" state worth drawing. When one does, the colour says who is
    // using it: grey = nobody listening, green = pi-hear waiting for speech,
    // yellow = busy (transcribing, or muted while the map talks back).
    in property <bool> mic-present: false;
    // Which language the recogniser is listening in: "" (unknown / pi-hear not
    // running), "日" or "En". Next to the microphone because the two answer one
    // question together -- whether it is listening, and to what.
    in property <string> mic-lang: "";
    in property <int> mic-state: 0;   // 0=idle, 1=busy, 2=listening
    in property <image> mic-icon;     // set from C++ (grey/yellow/green PNG)

    // Caption strip: what the voice stack is doing, in words. The screen is
    // frozen for seconds at a time while the recogniser has the CPU, so this
    // is the only thing telling the user the device is alive -- and, when a
    // command goes nowhere, whether it misheard or heard nothing at all.
    // Empty hides it. Styling follows acaption (the desktop caption overlay).
    in property <string> caption-text: "";
    in property <bool> caption-busy: false;

    // Voice UI stage, and what it is for:
    //   0 idle      nothing drawn
    //   1 armed     the wake word landed -- dim the map and show the waveform,
    //               so it is obvious the device is now listening to *you*, and
    //               obvious from the wave that it can actually hear you
    //   2 thinking  the utterance is with the recogniser -- the words got
    //               through, this is the part where you wait
    in property <int> voice-stage: 0;
    // Stylised waveform, as an SVG path built in C++ from one level value.
    // Not real samples: the point is legible feedback, not an oscilloscope.
    in property <string> wave-path: "";
    in property <float> wave-pulse: 0.0;   // 0..1, drives the glow

    // Keyboard: arrow keys pan, Shift+Up/Down zoom. This FocusScope grabs focus
    // on startup (init below) so the arrows do NOT land on the zoom Slider (which
    // would otherwise consume Up/Down as zoom). Unhandled keys from other widgets
    // bubble up to this ancestor scope, so panning works whatever has focus,
    // except the Slider itself.
    callback pan(/* dx */ float, /* dy */ float);
    init => { keys.focus(); }

    // Staged idle screensaver (driven entirely from C++; see main_gl.cpp).
    //   0 normal  1 DVD logo bounce  2 bouncing map tile  3 off / black
    // The C++ side stops the map render while saver-state > 0 and the opaque
    // overlay below covers the (stale) map texture. NEVER pushed upstream.
    in property <int> saver-state: 0;
    in property <length> logo-x: 40px;
    in property <length> logo-y: 40px;
    in property <brush> logo-color: #5050ff;
    in property <image> tile-image;
    // DVD logo: hand-tinted in C++ (the art is black-on-transparent, and Slint
    // `colorize` multiplies it to black, so we paint the alpha shape ourselves).
    in property <image> dvd-image;
    callback wake();

    // The map fills the whole window: the C++ side renders the live map (stage
    // 0) or the composited screensaver frame (black field + bouncing logo/tile)
    // into the FBO this MMapView displays 1:1. The screensaver is NOT drawn with
    // Slint overlay elements: in this zero-copy GL build femtovg only renders
    // the persistent full-screen MMapView's borrowed texture plus plain
    // Rectangles/Text; Image elements (CPU- or GL-backed) inside a conditional
    // overlay do not render at all. The touch controls below float over the map
    // and are hidden while the screensaver runs.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                if (event.modifiers.shift) {
                    MMapAdapter.wheel-zoomed(map.width / 2 / 1px, map.height / 2 / 1px, -1);
                } else {
                    root.pan(0, 80);
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (event.modifiers.shift) {
                    MMapAdapter.wheel-zoomed(map.width / 2 / 1px, map.height / 2 / 1px, 1);
                } else {
                    root.pan(0, -80);
                }
                return accept;
            }
            if (event.text == Key.LeftArrow) { root.pan(80, 0); return accept; }
            if (event.text == Key.RightArrow) { root.pan(-80, 0); return accept; }
            return reject;
        }

        map := MMapView {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            style-url: "file:///opt/kaga/data/style.json";
            center-lat: 0;
            center-lon: 0;
            zoom: 1;
        }

        // Floating touch controls over the map; hidden during the screensaver.
        Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;
            visible: root.saver-state == 0;

            // Toolbar (top): style dropdown + quick city jumps. Full width
            // (the zoom strip sits below it on the right).
            HorizontalBox {
                x: 22px;
                y: 36px;
                width: parent.width - 44px;
                height: 64px;
                spacing: 8px;
                ComboBox {
                    horizontal-stretch: 2;
                    model: root.style-names;
                    current-index: 0;
                    selected => { map.style-url = root.style-urls[self.current-index]; }
                }
                ComboBox {
                    horizontal-stretch: 2;
                    model: root.volcano-names;
                    // Default index 4 = 樽前山, matching MAPLIBRE_CENTER's
                    // default initial view (near Tomakomai/Shikotsu-ko --
                    // vbm.pmtiles' own embedded centre point). `<=>`-aliased
                    // to root.volcano-current-index (not a plain literal
                    // default any more) so patrol mode can also drive which
                    // entry shows as selected -- showing an unrelated
                    // volcano here while a different one is actually on
                    // screen would read as a bug at a glance, doubly so
                    // during an unattended demo (dwg7/kaga0#1).
                    current-index <=> root.volcano-current-index;
                    // A fly-to shortcut list, not persistent view state --
                    // unlike the style ComboBox, picking the same entry
                    // twice should still fly there again, and there is no
                    // "current volcano" to reflect back into current-index.
                    selected => {
                        map.fly-to(root.volcanoes[self.current-index].lat,
                                   root.volcanoes[self.current-index].lon, 12);
                    }
                }
                // "巡回" (patrol) mode toggle (dwg7/kaga0#1): for demos/
                // events, cycles through the volcano list unattended so
                // kaga's performance stays visible without anyone touching
                // it. A persistent on/off toggle (not a momentary button,
                // unlike shutdown) -- clicking flips patrol-on, and the
                // colour reflects the current state so it reads correctly
                // at a glance even mid-demo. Placed immediately left of
                // shutdown per the issue's UI spec. Same
                // Rectangle+TouchArea construction as shutdown (fluent's
                // Button still has no colour-override property).
                Rectangle {
                    horizontal-stretch: 0;
                    min-width: 96px;
                    height: 100%;
                    background: root.patrol-on
                        ? (patrol-touch.pressed ? #1f6f3f : #2a9d5f)
                        : (patrol-touch.pressed ? #3a3a3a : #4a4a4a);
                    border-radius: 3px;
                    animate background { duration: 100ms; }
                    patrol-touch := TouchArea {
                        clicked => { root.patrol-on = !root.patrol-on; }
                    }
                    Text {
                        text: root.patrol-on ? "巡回中" : "巡回";
                        color: white;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // Shutdown button (2026-08-30, 藤村さん指示): kaga is meant to
                // be carried in keyboardless/networkless, so without an
                // on-screen way to power off, the only option is pulling the
                // plug -- risky for the SD card's filesystem. No confirmation
                // dialog by design; the point is making a clean shutdown at
                // least as easy as yanking power.
                //
                // A plain Rectangle+TouchArea rather than the std Button:
                // fluent's Button has no colour-override property (only a
                // fixed accent via `primary`), and this needs to visibly read
                // as the one critical/destructive control in the toolbar
                // (reddish), not just another button next to the ComboBoxes.
                Rectangle {
                    horizontal-stretch: 0;
                    min-width: 112px;
                    height: 100%;
                    background: shutdown-touch.pressed ? #8f2a20 : #c0392b;
                    border-radius: 3px;
                    animate background { duration: 100ms; }
                    shutdown-touch := TouchArea {
                        clicked => { root.request-shutdown(); }
                    }
                    Text {
                        text: "シャットダウン";
                        color: white;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Scale bar: bottom-left, docked directly above the
            // feature-attribute bar when it's showing (moved here from
            // top-left/below-the-toolbar, 藤村さん 2026-08-30: "属性が出る
            // ところのすぐ上に置いてほしい"). The attribute bar toggles
            // visibility on hover, so this can't just sit at a fixed
            // offset from the bottom -- y drops the attribute bar's own
            // height (26px) only while feature-info-text is non-empty,
            // landing flush against the screen bottom the rest of the
            // time. Styled as a cartographic "bracket" (baseline + two
            // upward end-ticks sized exactly to the measured distance,
            // label the same width directly above it) rather than a
            // padded UI chip -- matches the convention every desktop/web
            // map's scale control uses (Leaflet, MapLibre GL JS, Google
            // Maps). Only the label gets a slim dark backing for
            // legibility over the map; the bracket itself is bare white
            // lines the way a ruler overlay would be.
            if root.scale-bar-text != "" : Rectangle {
                x: 22px;
                y: parent.height - self.height
                    - (root.feature-info-text != "" ? 26px : 0px);
                width: root.scale-bar-width-px;
                height: 26px;
                background: transparent;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 15px;
                    background: #00000090;
                    border-radius: 2px;
                    Text {
                        width: 100%;
                        height: 100%;
                        text: root.scale-bar-text;
                        color: white;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {                                    // baseline
                    x: 0px;
                    y: 23px;
                    width: 100%;
                    height: 1px;
                    background: white;
                }
                Rectangle {                                    // left end-tick
                    x: 0px;
                    y: 18px;
                    width: 1px;
                    height: 6px;
                    background: white;
                }
                Rectangle {                                    // right end-tick
                    x: parent.width - 1px;
                    y: 18px;
                    width: 1px;
                    height: 6px;
                    background: white;
                }
            }

            // Dedicated top status bar (full-width strip above the toolbar).
            // GPS (satellite icon + sat count) on the left, battery on the right.
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 26px;
                background: #000000c0;
                // GPS satellite icon: grey=no device, yellow=no fix, green=fix.
                Image {                     // left; image comes from C++ (SharedPixelBuffer)
                    x: 8px;
                    y: 3px;
                    width: 20px;
                    height: 20px;
                    source: root.gps-icon;
                }
                Text {                      // satellite count (when GPS present)
                    x: 32px;
                    y: 0px;
                    width: 40px;
                    height: 100%;
                    visible: root.gps-state >= 1;
                    text: root.gps-sats;
                    color: root.gps-state == 2 ? #6ee06e : #ffd24d;
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
                Image {                     // microphone present (green); hidden otherwise
                    x: 80px;
                    y: 3px;
                    width: 20px;
                    height: 20px;
                    visible: root.mic-present;
                    source: root.mic-icon;
                }
                Text {                      // listening language, beside the mic
                    x: 104px;
                    y: 0px;
                    width: 26px;
                    height: 100%;
                    visible: root.mic-present && root.mic-lang != "";
                    text: root.mic-lang;
                    color: #6ee06e;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
                Image {                     // keyboard connected (green); hidden otherwise
                    x: 136px;
                    y: 3px;
                    width: 20px;
                    height: 20px;
                    visible: root.kbd-connected;
                    source: root.kbd-icon;
                }
                // Right cluster, left to right:  [Wi-Fi] SSID   [battery] AC NN%   HH:MM
                // Everything here is anchored to the right edge, so the widths
                // below are what each field is allowed to occupy. The battery
                // label is left-aligned so it sits against its icon: giving it
                // a wide right-aligned box instead leaves a gap that reads as a
                // layout bug.
                Image {                     // Wi-Fi: grey+red-X=down, yellow=no route, green=ok
                    x: parent.width - 264px;
                    y: 3px;
                    width: 20px;
                    height: 20px;
                    source: root.wifi-icon;
                }
                // SSID text removed for kaga (2026-08-30, 藤村さん判断): showing
                // the network name reads as at odds with the offline-appliance
                // premise. The Wi-Fi icon above still conveys connection state
                // (grey/yellow/green) without naming the network.
                Text {                      // dev-only: "<w>x<h> <fps>fps <cpu>%cpu <temp>°C"
                    x: parent.width - 564px;
                    y: 0px;
                    width: 300px;
                    height: 100%;
                    visible: root.debug-visible;
                    text: root.debug-text;
                    overflow: elide;
                    // Grey, not yellow: this is technical/diagnostic info
                    // (fps/resolution/CPU/temp), not something a meeting
                    // audience needs to notice -- unlike the feature-info
                    // bar's yellow, which is meant to be read (藤村さん,
                    // 2026-08-30).
                    color: #888888;
                    font-size: 14px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Image {                     // battery level/charge icon (Icons8)
                    x: parent.width - 152px;
                    y: 3px;
                    width: 20px;
                    height: 20px;
                    image-fit: contain;
                    visible: root.battery-percent >= 0;
                    source: root.battery-icon;
                }
                Text {                      // battery %, hard against its icon
                    x: parent.width - 128px;
                    y: 0px;
                    width: 66px;            // widest case: "BAT 100%"
                    height: 100%;
                    visible: root.battery-percent >= 0;
                    text: (root.battery-plugged ? "AC " : "BAT ") + root.battery-percent + "%";
                    color: root.battery-percent <= 20 ? #ff8080 : white;
                    font-size: 14px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
                // Wall clock removed (2026-08-31, dwg7/kaga0#2): the RPi has
                // no RTC battery, so in fully offline operation (no NTP) the
                // clock free-runs from whatever time it had at last shutdown
                // -- showing a wrong time is worse than showing none.
            }

            // Right-edge vertical zoom strip. Kept mostly for keyboard/
            // mouse-wheel parity, not as the primary zoom control any more
            // (wheel + double-click cover that) -- shrunk to about a third
            // of the screen height, vertically centred, so it reads as a
            // minor auxiliary control rather than spanning the whole edge
            // (藤村さん, 2026-08-30: "こじんまり" -- also frees up screen
            // height for the map on shorter displays).
            VerticalBox {
                width: 120px;
                x: parent.width - 128px;
                y: parent.height / 3;
                height: parent.height / 3;
                padding: 8px;
                spacing: 10px;
                Button {
                    min-height: 56px;
                    text: "+";
                    clicked => { MMapAdapter.wheel-zoomed(map.width / 2 / 1px, map.height / 2 / 1px, -1); }
                }
                Slider {
                    orientation: vertical;
                    vertical-stretch: 1;
                    minimum: 1;
                    maximum: 18;
                    value: 10;
                    changed value => { map.set-zoom(self.value); }
                }
                Button {
                    min-height: 56px;
                    text: "-";
                    clicked => { MMapAdapter.wheel-zoomed(map.width / 2 / 1px, map.height / 2 / 1px, 1); }
                }
            }

            // Dim the map while the device is listening to someone. Drawn over
            // the map but under the bar and toolbar, so the controls stay
            // readable. Display-only: taps fall through to the map.
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                visible: root.voice-stage > 0;
                background: root.voice-stage == 1 ? #00000066 : #0000008c;
            }

            // Waveform, in the band above the caption. Amplitude follows the
            // input level, so a flat line means "not hearing you" and says so
            // without words.
            Rectangle {
                x: 24px;
                y: parent.height - 236px;
                width: parent.width - 152px;
                height: 76px;
                visible: root.voice-stage == 1;
                background: #05070ecc;
                border-width: 1px;
                border-color: #1e3064;
                border-radius: 6px;
                // Centre line, so a silent wave still reads as a wave.
                Rectangle {
                    x: 10px;
                    y: parent.height / 2 - 1px;
                    width: parent.width - 20px;
                    height: 2px;
                    background: #1e30642e;
                }
                Path {
                    x: 10px;
                    y: 0px;
                    width: parent.width - 20px;
                    height: 100%;
                    viewbox-width: 100;
                    viewbox-height: 100;
                    commands: root.wave-path;
                    stroke: #7ab0f0;
                    stroke-width: 2px;
                }
                // Level bar: the same number again, unambiguously.
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 10px;
                    width: max(8px, (parent.width - 24px) * root.wave-pulse);
                    height: 4px;
                    background: #3d6bbf59;
                    border-radius: 2px;
                }
            }

            // Caption strip, above the bottom-left toggle and clear of the
            // right-edge zoom column. Display-only (no TouchArea), so it stays
            // transparent to taps meant for the map underneath.
            Rectangle {
                x: 24px;
                y: parent.height - 152px;
                width: parent.width - 152px;
                height: 44px;
                visible: root.caption-text != "";
                background: #05070ee0;
                border-width: 1px;
                border-color: #1e306461;
                border-radius: 6px;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    height: 100%;
                    text: root.caption-text;
                    // Dim while working, bright once there is something to read.
                    color: root.caption-busy ? #4a6090 : #b8cce8;
                    font-size: 20px;
                    overflow: elide;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Dance/Calm and Sync controls removed for kaga: v0 has no terrain
            // tiles, so pitch/bearing 3D camera moves are out of scope until
            // that changes (see docs/decisions/0014). The underlying
            // dancing/sensor-available/sync-toggled bindings stay wired below
            // (untouched by C++) so this can come back without a rebuild of
            // main_gl.cpp; only the on-screen controls are gone.

            // VBM/VLCM feature-attribute readout (kaga challenge goal,
            // 2026-08-30). Hover-only (no press) via MMapAdapter.mouse-hovered
            // -> main_gl.cpp's saver_timer throttles the actual
            // queryRenderedFeatures call. Hidden whenever there is nothing to
            // show (background, bvmap-only area, or the cursor has left the
            // map) rather than showing an empty bar.
            //
            // Full-width one-line bottom pane, not a cursor-following
            // tooltip/balloon (藤村さん: 「吹き出しは無様だ」) -- same idea as
            // dwg7/sas0's docked info panel under its status map.
            Rectangle {
                x: 0px;
                y: parent.height - self.height;
                width: 100%;
                // Matches the toolbar ComboBoxes' own rendered height
                // (fluent's `min-height: max(32px, layout.min-height)`,
                // internal/compiler/widgets/fluent/combobox.slint) so the
                // font size and the vertical margin around it read as the
                // same control language as the volcano dropdown, not a
                // separate cramped debug-panel style (藤村さん, 2026-08-30).
                height: 32px;
                visible: root.feature-info-text != "";
                background: #000000c0;
                // The polygon's own fill color from the map, so the label
                // reads back onto what is actually on screen rather than
                // floating unconnected in a plain text bar (藤村さん,
                // 2026-08-30). Transparent (unknown color) just blends into
                // the bar background -- text alone still carries the panel.
                Rectangle {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    border-radius: 2px;
                    background: root.feature-info-color;
                }
                Text {
                    x: 36px;
                    width: parent.width - 48px;
                    height: 100%;
                    text: root.feature-info-text;
                    overflow: elide;
                    // Yellow, and the same size as the toolbar ComboBoxes'
                    // default text (default-font-size on the root Window,
                    // 20px) -- general-audience readability over a
                    // technical/small debug-panel look (藤村さん, 2026-08-30).
                    color: #ffd24d;
                    font-size: root.default-font-size;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }
        }
    } // keys (FocusScope)


    // Screensaver. Hard-won rendering rules for this zero-copy GL + femtovg
    // build (all verified by glReadPixels, not eyeballing):
    //   * The black field is a Rectangle gated with `if` (Rectangles created at
    //     runtime render fine).
    //   * The bouncing IMAGES must be ALWAYS present (an Image created when an
    //     `if` flips true at runtime never uploads its texture and stays blank),
    //     gated with `opacity`, and placed AFTER the overlay so they draw on top.
    if root.saver-state > 0 : Rectangle {
        width: 100%;
        height: 100%;
        background: black;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { root.wake(); }
            }
        }
    }
    // Stage 1: recoloured DVD logo (hand-tinted SharedPixelBuffer from C++).
    Image {
        opacity: root.saver-state == 1 ? 1.0 : 0.0;
        x: root.logo-x;
        y: root.logo-y;
        width: 140px;
        height: 84px;
        source: root.dvd-image;
        image-fit: contain;
    }
    // Stage 2: a 220x220 pre-rendered map tile (mbgl-render PNG, loaded in C++).
    Image {
        opacity: root.saver-state == 2 ? 1.0 : 0.0;
        x: root.logo-x;
        y: root.logo-y;
        width: 220px;
        height: 220px;
        source: root.tile-image;
        image-fit: fill;
    }
}
